<div class="min-h-screen bg-base-light-50 dark:bg-base-dark-900 text-base-light-900 dark:text-base-dark-100">
  <.header
    socket={@socket}
    prefix={@prefix}
    lens={@lens}
    theme={@theme}
    clarity_pid={@clarity_pid}
    section={:reports}
    navigation={false}
    lens_path={&report_lens_path(@prefix, &1, @selected)}
  />

  <div class="max-w-[100ch] mx-auto p-6">
    <%= if @reports == [] do %>
      <p id="no-reports" class="italic opacity-70">No reports are registered.</p>
    <% else %>
      <nav
        id="report-tabs"
        class="border-b border-base-light-300 dark:border-base-dark-700 mb-6"
      >
        <ul class="content-tabs flex min-w-0 overflow-x-auto">
          <li :for={report <- @reports} class="flex shrink-0">
            <.link
              patch={Path.join([@prefix, @lens.id, "reports", Clarity.Report.report_id(report)])}
              class="content-tab"
              aria-current={report == @selected && "page"}
              title={Clarity.Report.description(report)}
            >
              {report.name()}
            </.link>
          </li>
        </ul>
      </nav>

      <p
        :if={@working?}
        id="report-working"
        class="mb-6 text-sm text-base-light-600 dark:text-base-dark-400"
      >
        Clarity is still introspecting, so this report may be incomplete. It updates
        when introspection finishes.
      </p>

      <.live_component
        :if={@selected}
        module={@selected}
        id="report"
        graph={@graph}
        version={@version}
        lens={@lens}
        prefix={@prefix}
      />
    <% end %>
  </div>
</div>
