<%= case @lens do %>
  <% nil -> %>
    <.lens_not_found_error prefix={@prefix} />
  <% lens -> %>
    <article class="layout-container bg-base-light-50 dark:bg-base-dark-900 text-base-light-900 dark:text-base-dark-100">
      <.header
        socket={@socket}
        prefix={@prefix}
        clarity_pid={@clarity_pid}
        class="header z-10"
      />

      <.activity_bar prefix={@prefix} lenses={@lenses} lens={lens} section={:explore} />

      <%!-- One shared element for every hover hint; the Tooltip hook owns its content. --%>
      <div
        id="clarity-tooltip"
        role="tooltip"
        popover="manual"
        phx-hook="Tooltip"
        phx-update="ignore"
        class="clarity-tooltip"
        hidden
      >
      </div>
      <.vertex_icon_sprite />

      <.async_result :let={data} assign={@data}>
        <:loading>
          <%!-- The splash covers introspection. Once the graph is loaded, a page
               reached by navigation (e.g. Explore from Reports) loads its data
               without it. --%>
          <%= if @clarity.status == :working do %>
            <.splash_screen />
          <% else %>
            <.page_loading />
          <% end %>
        </:loading>
        <:failed :let={reason}>
          <%= case reason do %>
            <% :vertex_not_found -> %>
              <.vertex_not_found_error prefix={@prefix} lens={lens} />
            <% _reason -> %>
              <.data_load_error prefix={@prefix} lens={lens} />
          <% end %>
        </:failed>

        <%= if @vertex do %>
          <nav class={"navigation bg-base-light-100 dark:bg-base-dark-800 border-r border-base-light-300 dark:border-base-dark-700 px-2 pb-3 md:block #{if @show_navigation, do: "block", else: "hidden"}"}>
            <div class="nav-heading">
              <span>{lens.name}</span>
            </div>
            <.live_component
              module={Clarity.TreeComponent}
              id="navigation-tree"
              graph={data.graph}
              loading?={@data.loading != nil}
              active_vertex={@vertex}
              breadcrumbs={@breadcrumbs}
              prefix={@prefix}
              lens={lens}
              opened={@tree_opened}
              collapsed={@tree_collapsed}
              name_style={@tree_name_style}
            />
          </nav>
          <div
            id="nav-resize"
            class="nav-resize"
            phx-hook="NavPanel"
            role="separator"
            aria-orientation="vertical"
            aria-label="Resize navigation"
            tabindex="0"
          >
          </div>

          <% type = Tooltip.type_icon(@vertex) %>
          <div class="title page-title bg-base-light-50 dark:bg-base-dark-900 border-b border-base-light-300 dark:border-base-dark-700 px-4 py-3">
            <nav
              :if={breadcrumb_trail(@breadcrumbs) != []}
              class="breadcrumbs"
              aria-label="Breadcrumbs"
            >
              <ol class="page-crumbs">
                <li :for={
                  {{breadcrumb, name}, idx} <-
                    Enum.with_index(named_trail(@breadcrumbs, @name_style))
                }>
                  <span :if={idx > 0} class="page-crumb-arrow" aria-hidden="true">→</span>
                  <.link
                    patch={Path.join([@prefix, @lens.id, Vertex.id(breadcrumb)])}
                    {Tooltip.attrs(breadcrumb)}
                    class="page-crumb"
                  >
                    <% crumb_type = Tooltip.type_icon(breadcrumb) %>
                    <svg class="tree-icon" data-tone={crumb_type.tone} aria-hidden="true">
                      <use href={"#clarity-icon-#{crumb_type.icon}"} />
                    </svg>
                    {name}
                  </.link>
                </li>
              </ol>
            </nav>
            <div class="page-subject">
              <svg class="page-subject-icon" data-tone={type.tone} aria-hidden="true">
                <use href={"#clarity-icon-#{type.icon}"} />
              </svg>
              <h1 class="page-subject-name">
                {@breadcrumbs |> named_path(@vertex, @name_style) |> List.last()}
              </h1>
              <span class="ov-pill" data-tone={type.tone}>{Tooltip.type_name(@vertex)}</span>
            </div>
          </div>
          <.tabs
            contents={@contents}
            content={@content}
            prefix={@prefix}
            vertex={@vertex}
            lens={lens}
            vertex_status_classes={@vertex_status_classes}
          />
          <%= cond do %>
            <% not @data.ok? -> %>
              <div class="content">
                <.splash_screen />
              </div>
            <% @contents == [] -> %>
              <.empty_state
                id="no-lens-content"
                title={"Nothing to show in the #{lens.name} lens"}
                class="content"
              >
                <:icon><.icon_aperture /></:icon>
                The {lens.name} lens has no tabs for {Vertex.name(@vertex)}. Pick something in
                the tree, or look through another lens.
              </.empty_state>
            <% true -> %>
              <.render_content
                content={@content}
                vertex={@vertex}
                socket={@socket}
                theme={@theme}
                prefix={@prefix}
                lens={lens}
                zoom_graph={data.zoom_graph}
                graph={@clarity.graph}
                linking={@linking}
                name_style={@name_style}
                zoom_level={@zoom_level}
                shown_vertex_types={@shown_vertex_types}
                available_vertex_types={@available_vertex_types}
              />
          <% end %>
          <% {content_type, raw_content} =
            case @content && @content.render_static do
              {:mermaid, content_fn} ->
                props = %{
                  theme: @theme,
                  zoom_subgraph: data.zoom_graph,
                  zoom_level: @zoom_level,
                  shown_vertex_types: @shown_vertex_types,
                  available_vertex_types: @available_vertex_types,
                  name_style: @name_style
                }

                {"mermaid", IO.iodata_to_binary(content_fn.(props))}

              {:viz, content_fn} ->
                props = %{
                  theme: @theme,
                  zoom_subgraph: data.zoom_graph,
                  zoom_level: @zoom_level,
                  shown_vertex_types: @shown_vertex_types,
                  available_vertex_types: @available_vertex_types,
                  name_style: @name_style
                }

                {"graphviz", IO.iodata_to_binary(content_fn.(props))}

              {:markdown, content_fn} ->
                props = %{
                  theme: @theme,
                  zoom_subgraph: data.zoom_graph,
                  zoom_level: @zoom_level,
                  shown_vertex_types: @shown_vertex_types,
                  available_vertex_types: @available_vertex_types,
                  name_style: @name_style
                }

                {"markdown", IO.iodata_to_binary(content_fn.(props))}

              _ ->
                {"", ""}
            end %>
          <.raw_content_drawer
            show={@show_raw_drawer && content_type != ""}
            content_type={content_type}
            raw_content={raw_content}
          />
        <% end %>
      </.async_result>
    </article>
<% end %>
