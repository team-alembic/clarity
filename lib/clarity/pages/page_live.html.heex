<%= case @lens do %>
  <% nil -> %>
    <.lens_not_found_error prefix={@prefix} />
  <% lens -> %>
    <article class="layout-container bg-base-light-50 dark:bg-base-dark-900 text-base-light-900 dark:text-base-dark-100">
      <.header
        socket={@socket}
        prefix={@prefix}
        theme={@theme}
        clarity_pid={@clarity_pid}
        class="header z-10"
      />

      <.activity_bar prefix={@prefix} lenses={@lenses} lens={lens} section={:explore} />

      <%!-- One shared element for every hover hint; the Tooltip hook owns its content. --%>
      <div
        id="clarity-tooltip"
        role="tooltip"
        popover="manual"
        phx-hook="Tooltip"
        phx-update="ignore"
        class="clarity-tooltip"
        hidden
      >
      </div>
      <.vertex_icon_sprite />

      <.async_result :let={data} assign={@data}>
        <:loading>
          <%!-- The splash covers introspection. Once the graph is loaded, a page
               reached by navigation (e.g. Explore from Reports) loads its data
               without it. --%>
          <.splash_screen :if={@clarity.status == :working} />
        </:loading>
        <:failed :let={reason}>
          <%= case reason do %>
            <% :vertex_not_found -> %>
              <.vertex_not_found_error prefix={@prefix} lens={lens} />
            <% _reason -> %>
              <.data_load_error prefix={@prefix} lens={lens} />
          <% end %>
        </:failed>

        <%= if @vertex do %>
          <nav class={"navigation bg-base-light-100 dark:bg-base-dark-800 border-r border-base-light-300 dark:border-base-dark-700 px-2 pb-3 md:block #{if @show_navigation, do: "block", else: "hidden"}"}>
            <div class="nav-heading">
              <span>{lens.name}</span>
            </div>
            <.live_component
              module={Clarity.TreeComponent}
              id="navigation-tree"
              graph={data.graph}
              loading?={@data.loading != nil}
              active_vertex={@vertex}
              breadcrumbs={@breadcrumbs}
              prefix={@prefix}
              lens={lens}
              opened={@tree_opened}
              collapsed={@tree_collapsed}
              name_style={@tree_name_style}
            />
          </nav>
          <div
            id="nav-resize"
            class="nav-resize"
            phx-hook="NavPanel"
            role="separator"
            aria-orientation="vertical"
            aria-label="Resize navigation"
            tabindex="0"
          >
          </div>

          <div class="title bg-base-light-50 dark:bg-base-dark-900 border-b border-base-light-300 dark:border-base-dark-700 px-4 py-3 flex items-center">
            <nav class="breadcrumbs mr-3">
              <ol class="flex flex-wrap text-xs text-base-light-600 dark:text-base-dark-400 space-x-1">
                <%= for {breadcrumb, idx} <- Enum.with_index(breadcrumb_trail(@breadcrumbs)) do %>
                  <li class="flex items-center">
                    <span :if={idx > 0} class="mx-1 text-base-light-500 dark:text-base-dark-600">
                      →
                    </span>
                    <.link
                      patch={Path.join([@prefix, @lens.id, Vertex.id(breadcrumb)])}
                      {Tooltip.attrs(breadcrumb)}
                      class="hover:text-primary-light dark:hover:text-primary-dark transition-colors"
                    >
                      {Vertex.name(breadcrumb)}
                    </.link>
                  </li>
                <% end %>
                <%= if breadcrumb_trail(@breadcrumbs) != [] do %>
                  <li class="flex items-center">
                    <span class="mx-1 text-base-light-500 dark:text-base-dark-600">→</span>
                  </li>
                <% end %>
              </ol>
            </nav>
            <h1 class="text-2xl font-bold text-base-light-900 dark:text-base-dark-100">
              {Vertex.name(@vertex)}
            </h1>
          </div>
          <.tabs
            contents={@contents}
            content={@content}
            prefix={@prefix}
            vertex={@vertex}
            lens={lens}
            vertex_status_classes={@vertex_status_classes}
          />
          <%= cond do %>
            <% not @data.ok? -> %>
              <div class="content">
                <.splash_screen />
              </div>
            <% @contents == [] -> %>
              <div
                id="no-lens-content"
                class="content p-6 text-sm text-base-light-600 dark:text-base-dark-400"
              >
                The {lens.name} lens has nothing to show for {Vertex.name(@vertex)}.
              </div>
            <% true -> %>
              <.render_content
                content={@content}
                vertex={@vertex}
                socket={@socket}
                theme={@theme}
                prefix={@prefix}
                lens={lens}
                zoom_graph={data.zoom_graph}
                graph={@clarity.graph}
                zoom_level={@zoom_level}
                shown_vertex_types={@shown_vertex_types}
                available_vertex_types={@available_vertex_types}
              />
          <% end %>
          <% {content_type, raw_content} =
            case @content && @content.render_static do
              {:mermaid, content_fn} ->
                props = %{
                  theme: @theme,
                  zoom_subgraph: data.zoom_graph,
                  zoom_level: @zoom_level,
                  shown_vertex_types: @shown_vertex_types,
                  available_vertex_types: @available_vertex_types
                }

                {"mermaid", IO.iodata_to_binary(content_fn.(props))}

              {:viz, content_fn} ->
                props = %{
                  theme: @theme,
                  zoom_subgraph: data.zoom_graph,
                  zoom_level: @zoom_level,
                  shown_vertex_types: @shown_vertex_types,
                  available_vertex_types: @available_vertex_types
                }

                {"graphviz", IO.iodata_to_binary(content_fn.(props))}

              {:markdown, content_fn} ->
                props = %{
                  theme: @theme,
                  zoom_subgraph: data.zoom_graph,
                  zoom_level: @zoom_level,
                  shown_vertex_types: @shown_vertex_types,
                  available_vertex_types: @available_vertex_types
                }

                {"markdown", IO.iodata_to_binary(content_fn.(props))}

              _ ->
                {"", ""}
            end %>
          <.raw_content_drawer
            show={@show_raw_drawer && content_type != ""}
            content_type={content_type}
            raw_content={raw_content}
          />
        <% end %>
      </.async_result>
    </article>
<% end %>
