<%!--
  Each list of a node's items draws a guide down its left edge; the top level,
  under the root, has none. As in VS Code, the active guide is the one beside
  the current vertex's own items when it is open, or else the one beside it
  and its siblings.
--%>
<%= case navigation_groups(@graph, @vertex, @collapsed, @name_style, @active_vertex, @visible_ids) do %>
  <% [%{long?: false} = group] -> %>
    <%!-- A lone group says nothing the items' icons don't, so it gets no row,
         unless it is long and needs one to fold it away. --%>
    <.group_items
      group={group}
      class={!@root? && guide_class(group.active? or current?(@vertex, @active_vertex))}
      {tree_assigns(assigns)}
    />
  <% groups -> %>
    <div class={!@root? && guide_class(current?(@vertex, @active_vertex))}>
      <details
        :for={group <- groups}
        id={"tree-group-#{group.id}"}
        open={group.open?}
        phx-hook="Details"
        phx-toggle="toggle_group"
        phx-value-group_id={group.id}
        phx-target={@myself}
        class="tree-node select-none"
      >
        <summary class="flex items-center cursor-pointer text-base-light-600 dark:text-base-dark-400">
          <.icon_chevron_right class="tree-chevron" aria-hidden="true" />
          <span class="min-w-0 truncate px-1 py-px">
            {group.label}
            <span
              :if={group.long?}
              class="tabular-nums text-base-light-500 dark:text-base-dark-500"
            >
              ({group.count})
            </span>
          </span>
        </summary>
        <.group_items
          :if={group.open?}
          group={group}
          class={guide_class(group.active?)}
          {tree_assigns(assigns)}
        />
      </details>
    </div>
<% end %>
