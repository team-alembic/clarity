<details
  :for={group <- navigation_groups(@graph, @vertex, @collapsed)}
  id={"tree-group-#{group.id}"}
  open={group.open?}
  phx-hook="Details"
  phx-toggle="toggle_group"
  phx-value-group_id={group.id}
  phx-target={@myself}
  class="tree-node select-none"
>
  <summary class="flex items-center cursor-pointer text-base-light-600 dark:text-base-dark-400">
    <.icon_chevron_right class="tree-chevron" aria-hidden="true" />
    <span class="px-1.5 py-px">{group.label}</span>
  </summary>
  <ul :if={group.open?} class="tree-children">
    <li :for={child <- group.children}>
      <.render_node
        graph={@graph}
        vertex={child}
        visible_ids={@visible_ids}
        collapsed={@collapsed}
        active_vertex={@active_vertex}
        prefix={@prefix}
        lens={@lens}
        myself={@myself}
        name_style={@name_style}
        status_index={@status_index}
        any_sibling_has_children={group.any_has_children?}
      />
    </li>
  </ul>
</details>
