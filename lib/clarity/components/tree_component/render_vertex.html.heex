<%!--
  Each list of a node's items draws a guide down its left edge, marked active
  when it holds the current vertex; the top level, under the root, has none.
--%>
<%= case navigation_groups(@graph, @vertex, @collapsed, @name_style, @active_vertex) do %>
  <% [group] -> %>
    <%!-- A lone group says nothing the items' icons don't, so it gets no row. --%>
    <.group_items group={group} class={!@root? && guide_class(group)} {tree_assigns(assigns)} />
  <% groups -> %>
    <div class={!@root? && "tree-children"}>
      <details
        :for={group <- groups}
        id={"tree-group-#{group.id}"}
        open={group.open?}
        phx-hook="Details"
        phx-toggle="toggle_group"
        phx-value-group_id={group.id}
        phx-target={@myself}
        class="tree-node select-none"
      >
        <summary class="flex items-center cursor-pointer text-base-light-600 dark:text-base-dark-400">
          <.icon_chevron_right class="tree-chevron" aria-hidden="true" />
          <span class="min-w-0 truncate px-1 py-px">{group.label}</span>
        </summary>
        <.group_items
          :if={group.open?}
          group={group}
          class={guide_class(group)}
          {tree_assigns(assigns)}
        />
      </details>
    </div>
<% end %>
