<%= if has_children?(@graph, @vertex) do %>
  <details
    id={"tree-node-#{Vertex.id(@vertex)}"}
    open={open?(@vertex, @visible_ids)}
    phx-hook="Details"
    phx-toggle="toggle"
    phx-value-vertex_id={Vertex.id(@vertex)}
    phx-target={@myself}
    class="tree-node select-none"
  >
    <summary class="flex items-center cursor-pointer">
      <.icon_chevron_right class="tree-chevron" aria-hidden="true" />
      <.node_link
        vertex={@vertex}
        active_vertex={@active_vertex}
        prefix={@prefix}
        lens={@lens}
        name_style={@name_style}
      />
      <.status_badge entry={@status_index[Vertex.id(@vertex)]} />
    </summary>
    <div :if={open?(@vertex, @visible_ids)} class="tree-children">
      <.render_vertex
        graph={@graph}
        vertex={@vertex}
        visible_ids={@visible_ids}
        collapsed={@collapsed}
        active_vertex={@active_vertex}
        prefix={@prefix}
        lens={@lens}
        myself={@myself}
        name_style={@name_style}
        status_index={@status_index}
      />
    </div>
  </details>
<% else %>
  <div class="flex items-center select-none">
    <span :if={@any_sibling_has_children} class="w-4 shrink-0" aria-hidden="true"></span>
    <.node_link
      vertex={@vertex}
      active_vertex={@active_vertex}
      prefix={@prefix}
      lens={@lens}
      name_style={@name_style}
    />
    <.status_badge entry={@status_index[Vertex.id(@vertex)]} />
  </div>
<% end %>
