<%= if has_children?(@graph, @vertex) do %>
  <%!-- A row, not a <details>: its link and badge can't sit in a <summary>. --%>
  <div id={"tree-node-#{Vertex.id(@vertex)}"} class="tree-node select-none">
    <div class="tree-row flex items-center">
      <button
        type="button"
        class="tree-toggle"
        aria-expanded={to_string(open?(@vertex, @visible_ids))}
        aria-label={if(open?(@vertex, @visible_ids), do: "Collapse", else: "Expand")}
        phx-click={toggle(@vertex, @visible_ids)}
        phx-target={@myself}
      >
        <.icon_chevron_right class="tree-chevron" aria-hidden="true" />
      </button>
      <.node_link
        vertex={@vertex}
        active_vertex={@active_vertex}
        prefix={@prefix}
        lens={@lens}
        name={@name}
        providers={@providers}
        toggle={toggle(@vertex, @visible_ids)}
        myself={@myself}
      />
      <.status_badge entry={@status_index[Vertex.id(@vertex)]} prefix={@prefix} lens={@lens} />
    </div>
    <div :if={open?(@vertex, @visible_ids)}>
      <.render_vertex
        graph={@graph}
        vertex={@vertex}
        visible_ids={@visible_ids}
        collapsed={@collapsed}
        active_vertex={@active_vertex}
        prefix={@prefix}
        lens={@lens}
        myself={@myself}
        name_style={@name_style}
        status_index={@status_index}
        providers={@providers}
      />
    </div>
  </div>
<% else %>
  <div class="flex items-center select-none">
    <span :if={@any_sibling_has_children} class="w-4 shrink-0" aria-hidden="true"></span>
    <.node_link
      vertex={@vertex}
      active_vertex={@active_vertex}
      prefix={@prefix}
      lens={@lens}
      name={@name}
      providers={@providers}
    />
    <.status_badge entry={@status_index[Vertex.id(@vertex)]} prefix={@prefix} lens={@lens} />
  </div>
<% end %>
