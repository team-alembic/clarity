<header
  class={"flex items-center px-6 py-4 bg-base-light-100 dark:bg-base-dark-800 shadow-md #{@class}"}
  {@rest}
>
  <.link navigate={@prefix} class="mr-4">
    <img
      src={Clarity.Resources.logo_uri()}
      alt="Ash Logo"
      class="h-8 w-8"
    />
  </.link>
  <h1 class="text-2xl font-bold tracking-tight flex-1 truncate text-base-light-900 dark:text-base-dark-50">
    <.link navigate={@prefix} class="mr-4">
      Clarity
    </.link>
  </h1>

  <div class="flex justify-center mx-4">
    {live_render(@socket, Clarity.Components.StatusLive,
      id: "clarity-status",
      session: %{"clarity_pid" => @clarity_pid}
    )}
  </div>

  <div class="flex items-center space-x-2">
    <% has_reports = @lens && Clarity.Report.applicable(@lens) != [] %>
    <div
      :if={has_reports}
      class="inline-flex rounded-md overflow-hidden ring-1 ring-inset ring-base-light-300 dark:ring-base-dark-600 mr-1"
    >
      <.link
        navigate={Path.join([@prefix, @lens.id])}
        class={[
          "px-3 py-1.5 text-sm font-medium transition-colors",
          if(@mode == :explore,
            do: "bg-primary-light dark:bg-primary-dark text-white",
            else:
              "text-base-light-600 dark:text-base-dark-400 hover:bg-base-light-200 dark:hover:bg-base-dark-700"
          )
        ]}
      >
        Explore
      </.link>
      <.link
        navigate={Path.join([@prefix, @lens.id, "report"])}
        class={[
          "px-3 py-1.5 text-sm font-medium transition-colors",
          if(@mode == :report,
            do: "bg-primary-light dark:bg-primary-dark text-white",
            else:
              "text-base-light-600 dark:text-base-dark-400 hover:bg-base-light-200 dark:hover:bg-base-dark-700"
          )
        ]}
      >
        Reports
      </.link>
    </div>
    <.live_component
      module={Clarity.LensSwitcherComponent}
      id="lens-switcher"
      prefix={@prefix}
      lens={@lens}
    />
    <.theme_toggle id="header-theme-toggle" theme={@theme} />
    <button
      type="button"
      class="inline-flex items-center justify-center p-2 rounded-md text-base-light-600 dark:text-base-dark-400 hover:text-base-light-900 dark:hover:text-base-dark-100 hover:bg-base-light-200 dark:hover:bg-base-dark-700 md:hidden"
      phx-click="toggle_navigation"
      aria-label="Toggle navigation"
    >
      <.icon_menu class="size-6" />
    </button>
  </div>
</header>
