<header
  class={"flex items-center h-12 px-4 bg-base-light-100 dark:bg-base-dark-800 border-b border-base-light-300 dark:border-base-dark-700 #{@class}"}
  {@rest}
>
  <.link navigate={@prefix} class="mr-2.5">
    <img
      src={Clarity.Resources.logo_uri()}
      alt="Clarity logo"
      class="size-6"
    />
  </.link>
  <h1 class="text-base font-semibold tracking-tight flex-1 truncate text-base-light-900 dark:text-base-dark-50">
    <.link navigate={@prefix}>
      Clarity
    </.link>
  </h1>

  <div class="flex justify-center mx-4">
    {live_render(@socket, Clarity.Components.StatusLive,
      id: "clarity-status",
      session: %{"clarity_pid" => @clarity_pid}
    )}
  </div>

  <div class="flex items-center gap-1">
    <.theme_toggle id="header-theme-toggle" theme={@theme} />
    <button
      type="button"
      class="inline-flex items-center justify-center p-2 rounded-md text-base-light-600 dark:text-base-dark-400 hover:text-base-light-900 dark:hover:text-base-dark-100 hover:bg-base-light-200 dark:hover:bg-base-dark-700 md:hidden"
      phx-click="toggle_navigation"
      aria-label="Toggle navigation"
    >
      <.icon_menu class="size-6" />
    </button>
  </div>
</header>
