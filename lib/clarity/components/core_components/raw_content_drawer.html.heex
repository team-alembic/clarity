<div
  id="raw-content-drawer"
  phx-hook="ResizableDrawer"
  data-min-width="400"
  data-max-width="1200"
  data-default-width="700"
  class={[
    "fixed inset-y-0 right-0 z-50",
    "bg-base-light-50 dark:bg-base-dark-900",
    "border-l border-base-light-300 dark:border-base-dark-700",
    "shadow-xl flex flex-col",
    if(@show, do: "translate-x-0", else: "translate-x-full pointer-events-none")
  ]}
  style="width: 700px; transition: transform 0.3s ease-in-out;"
>
  <div
    id="raw-content-drawer-resize-handle"
    class="absolute left-0 top-0 bottom-0 w-1 cursor-ew-resize hover:bg-primary-light/50 dark:hover:bg-primary-dark/50 active:bg-primary-light dark:active:bg-primary-dark transition-colors"
  >
  </div>
  <div class="flex items-center justify-between px-4 py-3 border-b border-base-light-300 dark:border-base-dark-700">
    <div class="flex items-center gap-2">
      <span class="px-2 py-1 text-xs font-medium rounded bg-primary-light/10 dark:bg-primary-dark/10 text-primary-light dark:text-primary-dark">
        {@content_type}
      </span>
      <h2 class="text-lg font-semibold text-base-light-900 dark:text-base-dark-100">
        Raw Source
      </h2>
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        phx-click={JS.dispatch("clarity:copy-to-clipboard", detail: %{content: @raw_content})}
        class="p-2 rounded-md hover:bg-base-light-200 dark:hover:bg-base-dark-800 text-base-light-600 dark:text-base-dark-400 hover:text-base-light-900 dark:hover:text-base-dark-100 transition-colors"
        title="Copy to clipboard"
      >
        <.icon_clipboard class="w-5 h-5" />
      </button>
      <button
        type="button"
        phx-click="close_raw_drawer"
        class="p-2 rounded-md hover:bg-base-light-200 dark:hover:bg-base-dark-800 text-base-light-600 dark:text-base-dark-400 hover:text-base-light-900 dark:hover:text-base-dark-100 transition-colors"
        title="Close"
      >
        <.icon_close class="w-5 h-5" />
      </button>
    </div>
  </div>
  <div class="flex-1 overflow-auto p-4">
    <pre class="text-sm font-mono whitespace-pre-wrap break-words text-base-light-800 dark:text-base-dark-200 bg-base-light-100 dark:bg-base-dark-800 rounded-lg p-4 overflow-x-auto"><code>{@raw_content}</code></pre>
  </div>
</div>
<%= if @show do %>
  <div
    id="raw-content-backdrop"
    class="fixed inset-0 z-40 bg-black/20 dark:bg-black/40"
    phx-click="close_raw_drawer"
  >
  </div>
<% end %>
