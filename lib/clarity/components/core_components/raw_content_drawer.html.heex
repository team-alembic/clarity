<div
  id="raw-content-drawer"
  phx-hook="ResizableDrawer"
  phx-window-keydown={@show && "close_raw_drawer"}
  phx-key={@show && "Escape"}
  role="dialog"
  aria-modal="true"
  aria-labelledby="raw-content-drawer-title"
  inert={!@show}
  data-min-width="400"
  data-max-width="1200"
  data-default-width="700"
  class={[
    "fixed inset-y-0 right-0 z-50 max-w-full",
    "bg-base-light-50 dark:bg-base-dark-900",
    "border-l border-base-light-300 dark:border-base-dark-700",
    "shadow-xl flex flex-col",
    if(@show, do: "translate-x-0", else: "translate-x-full pointer-events-none")
  ]}
  style="width: 700px; transition: transform 0.3s ease-in-out;"
>
  <div
    id="raw-content-drawer-resize-handle"
    class="absolute left-0 top-0 bottom-0 w-1 cursor-ew-resize hover:bg-primary-light/50 dark:hover:bg-primary-dark/50 active:bg-primary-light dark:active:bg-primary-dark transition-colors"
  >
  </div>
  <div class="flex h-12 shrink-0 items-center justify-between gap-2 pl-4 pr-2 border-b border-base-light-300 dark:border-base-dark-700 bg-base-light-100 dark:bg-base-dark-800">
    <h2
      id="raw-content-drawer-title"
      class="text-sm font-semibold text-base-light-900 dark:text-base-dark-100"
    >
      {source_format(@content_type)} source
    </h2>
    <div class="flex items-center gap-0.5">
      <button
        type="button"
        phx-click={JS.dispatch("clarity:copy-to-clipboard", detail: %{content: @raw_content})}
        class="icon-button copy-button"
        aria-label="Copy to clipboard"
        {Tooltip.attrs("Copy to clipboard")}
      >
        <.icon_clipboard class="copy-idle" />
        <.icon_check class="copy-done" />
      </button>
      <button
        type="button"
        phx-click="close_raw_drawer"
        class="icon-button"
        aria-label="Close"
        {Tooltip.attrs("Close")}
      >
        <.icon_close />
      </button>
    </div>
  </div>
  <%!-- Source keeps its lines as written; long ones scroll sideways. --%>
  <pre class="flex-1 overflow-auto p-4 text-[0.8125rem] leading-relaxed font-mono whitespace-pre text-base-light-800 dark:text-base-dark-200"><code>{@raw_content}</code></pre>
</div>
<%= if @show do %>
  <div
    id="raw-content-backdrop"
    class="fixed inset-0 z-40 bg-black/20 dark:bg-black/40"
    phx-click="close_raw_drawer"
  >
  </div>
<% end %>
