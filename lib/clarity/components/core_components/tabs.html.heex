<nav
  class="tabs border-b border-base-light-300 dark:border-base-dark-700 bg-base-light-100 dark:bg-base-dark-900 pl-2 pr-3 flex items-stretch gap-3"
  {@rest}
>
  <%!-- Tabs keep to one line; when there are more than fit, the row scrolls,
       keeping the current tab in view. --%>
  <ul
    id="content-tabs"
    phx-hook="Tabs"
    class="content-tabs relative flex min-w-0 flex-1 overflow-x-auto"
  >
    <li :for={content <- @contents} class="flex shrink-0">
      <.link
        patch={Path.join([@prefix, @lens.id, Clarity.Vertex.id(@vertex), content.id])}
        class="content-tab"
        aria-current={@content && content.id == @content.id && "page"}
        {Tooltip.attrs(content.description)}
      >
        {content.name}
        <%= case tab_status_severity(content, @vertex_status_classes) do %>
          <% nil -> %>
          <% severity -> %>
            <span
              class={[
                "inline-block w-2 h-2 rounded-full ml-1 align-middle",
                tab_status_dot(severity)
              ]}
              {Tooltip.attrs("#{severity} — see this tab")}
            ></span>
        <% end %>
      </.link>
    </li>
  </ul>

  <div class="flex shrink-0 items-center gap-0.5">
    <%= if @content && match?({type, _} when type in [:mermaid, :viz, :markdown], @content.render_static) do %>
      <button
        type="button"
        phx-click="toggle_raw_drawer"
        class="icon-button"
        aria-label="View source"
        {Tooltip.attrs("View source")}
      >
        <.icon_code />
      </button>
    <% end %>
    <%= if Vertex.SourceLocationProvider.source_location(@vertex) != nil do %>
      <.live_component
        module={Clarity.EditorButtonComponent}
        id="editor-button"
        source_location={Vertex.SourceLocationProvider.source_location(@vertex)}
      />
    <% end %>
  </div>
</nav>
