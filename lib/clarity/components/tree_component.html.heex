<%!--
  Rows are passed over on the way to others, so hints wait longer here. The
  Tree hook scrolls the current vertex's row into view when it or the lens
  changes, once the tree for them has loaded.
--%>
<div
  id={@id}
  class="clarity-tree text-sm"
  data-tooltip-delay="1500"
  phx-hook="Tree"
  data-current={"#{@lens.id}/#{Vertex.id(@active_vertex)}"}
  data-loading={@loading?}
>
  <.render_vertex
    graph={@graph}
    vertex={%Clarity.Vertex.Root{}}
    root?
    visible_ids={@visible_ids}
    collapsed={@collapsed}
    active_vertex={@active_vertex}
    prefix={@prefix}
    lens={@lens}
    myself={@myself}
    name_style={@name_style}
    status_index={@status_index}
    providers={@providers}
  />
</div>
