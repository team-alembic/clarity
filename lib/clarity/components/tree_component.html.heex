<%!-- Rows are passed over on the way to others, so hints wait longer here. --%>
<div class="text-sm" data-tooltip-delay="1500">
  <.render_vertex
    graph={@graph}
    vertex={%Clarity.Vertex.Root{}}
    visible_ids={@visible_ids}
    collapsed={@collapsed}
    active_vertex={@active_vertex}
    prefix={@prefix}
    lens={@lens}
    myself={@myself}
    name_style={@name_style}
    status_index={@status_index}
  />
</div>
