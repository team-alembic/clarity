#!/usr/bin/env sh
# Starts the demo app at http://localhost:4000 (PORT overrides), with live
# reload and asset watchers. The server replaces this script's process, so
# Ctrl-C stops it; `mix cmd` ran it in a session of its own, where Ctrl-C
# left it running.
set -e

cd "$(dirname "$0")/../demo"

# Clarity's own tabs and introspectors are listed in its mix.exs, which Mix
# copies into Clarity's .app. A running server rewrites that file from the
# mix.exs it started with, and the next start trusts it as up to date, so a
# tab added meanwhile goes missing. Removing it makes Mix write it afresh.
rm -f "_build/${MIX_ENV:-dev}/lib/clarity/ebin/clarity.app"

exec mix phx.server "$@"
